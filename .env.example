# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/elite_loadboard?schema=public"
# DIRECT_URL=   # optional — connection for migrations if using a pooler

# Application environment: local | development | staging | production | test
APP_ENV="local"

# Public URL of this deployment (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth.js / NextAuth
AUTH_SECRET=""                          # openssl rand -base64 32  (min 32 chars in staging/production)
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3000"    # legacy alias still supported

# File storage
# local = filesystem (development)
# s3 | r2 | minio = private object storage (staging/production)
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./storage"
# STORAGE_BUCKET=
# STORAGE_REGION=auto
# STORAGE_ENDPOINT=                 # required for R2/MinIO custom endpoints
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# ALLOW_LOCAL_STORAGE_IN_PRODUCTION=false

# Uploads
MAX_UPLOAD_SIZE_BYTES="26214400"        # 25 MB

# Seed / bootstrap safeguards (never enable casually in production)
# ALLOW_STAGING_SEED=false
# ALLOW_PRODUCTION_SEED=false
# SEED_ADMIN_PASSWORD=                # required if production seed explicitly allowed

# First production admin (scripts/bootstrap-admin.ts)
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_FIRST_NAME=System
# BOOTSTRAP_ADMIN_LAST_NAME=Admin
# COMPANY_NAME=ELITE Logistics
# COMPANY_TIMEZONE=America/Chicago
