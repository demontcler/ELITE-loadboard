# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/elite_loadboard?schema=public"

# Auth.js / NextAuth
AUTH_SECRET=""                          # openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"

# File storage
STORAGE_PROVIDER="local"                # local | s3
STORAGE_LOCAL_PATH="./storage"

# S3 / R2 (optional — required when STORAGE_PROVIDER=s3)
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
